#!/system/bin/sh

# HID WebUI wrapper script
# Serves the web interface and handles WebSocket connections

WEBUI_DIR="/data/adb/modules/hid-gadget/webui"
WEBUI_BIN="/system/bin/hid-webui-bin"

# For testing: if running from local directory, use local paths
if [ -f "./hid-webui" ] && [ -f "./webui/index.html" ]; then
    WEBUI_DIR="./webui"
    WEBUI_BIN="./hid-webui"
fi

# Check if server binary exists
if [ ! -f "$WEBUI_BIN" ]; then
    echo "Error: WebUI server binary not found at $WEBUI_BIN"
    exit 1
fi

# Check if webui directory exists
if [ ! -d "$WEBUI_DIR" ]; then
    echo "Error: WebUI directory not found at $WEBUI_DIR"
    echo "Tip: For testing, run from the module directory"
    exit 1
fi

# Start the WebSocket server
echo "Starting HID WebUI server..."
echo "WebUI directory: $WEBUI_DIR"
echo "Server binary: $WEBUI_BIN"
echo ""
echo "Open http://localhost:8080 in your browser"
echo "Press Ctrl+C to stop"
echo ""

cd "$WEBUI_DIR" || exit 1
exec "$WEBUI_BIN"
